{
  "name": "astra-ai",
  "version": "0.1.0",
  "description": "Astra AI Operating System - Desktop Application",
  "private": true,
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "npm run build && electron-builder",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.60.0",
    "@types/react-window": "^1.8.8",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^11.11.0",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^6.28.0",
    "react-syntax-highlighter": "^15.6.1",
    "react-window": "^2.3.0",
    "recharts": "^2.13.0",
    "tailwind-merge": "^2.5.0",
    "zustand": "^5.0.1"
},
  "devDependencies": {
    "@axe-core/react": "^4.12.1",
    "axe-core": "^4.12.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "eslint": "^9.14.0",
    "postcss": "^8.4.49",
    "rollup-plugin-visualizer": "^7.0.1",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.0.0",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "dev.astra.ai",
    "productName": "Astra AI",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/icon.png",
      "fileAssociations": [
        {
          "ext": "md",
          "name": "Markdown",
          "description": "Markdown document"
        },
        {
          "ext": "txt",
          "name": "Text",
          "description": "Text file"
        },
        {
          "ext": "pdf",
          "name": "PDF",
          "description": "PDF document"
        },
        {
          "ext": "csv",
          "name": "CSV",
          "description": "Comma-separated values"
        },
        {
          "ext": "json",
          "name": "JSON",
          "description": "JSON data file"
        },
        {
          "ext": "yaml",
          "name": "YAML",
          "description": "YAML configuration"
        },
        {
          "ext": "yml",
          "name": "YAML",
          "description": "YAML configuration"
        }
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "public/icon.png",
      "fileAssociations": [
        {
          "ext": "md",
          "name": "Markdown"
        },
        {
          "ext": "txt",
          "name": "Text"
        },
        {
          "ext": "pdf",
          "name": "PDF"
        },
        {
          "ext": "csv",
          "name": "CSV"
        },
        {
          "ext": "json",
          "name": "JSON"
        },
        {
          "ext": "yaml",
          "name": "YAML"
        },
        {
          "ext": "yml",
          "name": "YAML"
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "public/icon.png",
      "fileAssociations": [
        {
          "ext": "md",
          "name": "Markdown",
          "mimeType": "text/markdown"
        },
        {
          "ext": "txt",
          "name": "Text",
          "mimeType": "text/plain"
        },
        {
          "ext": "pdf",
          "name": "PDF",
          "mimeType": "application/pdf"
        },
        {
          "ext": "csv",
          "name": "CSV",
          "mimeType": "text/csv"
        },
        {
          "ext": "json",
          "name": "JSON",
          "mimeType": "application/json"
        },
        {
          "ext": "yaml",
          "name": "YAML",
          "mimeType": "application/x-yaml"
        },
        {
          "ext": "yml",
          "name": "YAML",
          "mimeType": "application/x-yaml"
        }
      ]
    }
  }
}
